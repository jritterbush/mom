---
import HTMLHead from '../components/HTMLHead.astro';
import '../styles/global.css';

interface Props {
	backgroundImage?: string;
}
const { backgroundImage } = Astro.props;
---

<!doctype html>
<html lang='en'>
	<head>
		<HTMLHead backgroundImage={backgroundImage} />
	</head>
	<body>
		<slot />
	</body>
</html>
