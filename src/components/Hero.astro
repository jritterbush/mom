---
import matter from 'gray-matter';
import { marked } from 'marked';
import markdownContentRaw from '../content/obituary.md?raw';
import { Image } from 'astro:assets';
import Container from './Container.astro';
import DonateLinks from './DonateLinks.astro';
import { IMG_CDN_URL } from '../constants/images.js';
import ReadMoreBlock from './ReadMoreBlock.astro';

interface Props {
	fullBackground: string;
	lowResBackground?: string;
}

const { fullBackground, lowResBackground } = Astro.props;

const backgroundUrl = `url(${fullBackground})`;
const placeholderUrl = lowResBackground ? `url(${lowResBackground})` : '';

const { data, content } = matter(markdownContentRaw);
const [summary, expandedContent] = content.split('---');
---

<style define:vars={{ backgroundUrl, placeholderUrl }}>
	header {
		background-image: var(--backgroundUrl), var(--placeholderUrl);
		background-color: var(--secondary);
		background-size: cover;
		background-position: center;
		padding: calc(16 * var(--spacing)) 0;
	}
	article {
		background-color: rgba(255, 255, 255, 0.75);
		padding: calc(6 * var(--spacing)) calc(6 * var(--spacing)) 0
			calc(6 * var(--spacing));
		border-radius: 12px;
		border: 1px solid #e0e0e0;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
	}
	article main {
		display: flex;
		gap: calc(6 * var(--spacing));
		align-items: stretch;
	}
	article img {
		max-height: 400px;
		width: auto;
		border-radius: 12px;
		border: 1px solid black;
	}
	footer {
		background-color: var(--primary);
		margin: calc(6 * var(--spacing)) calc(-6 * var(--spacing)) 0;
		padding: calc(3 * var(--spacing)) calc(6 * var(--spacing));
		border-radius: 0 0 12px 12px;
	}
	footer p {
		padding-top: 0;
	}
</style>

<header id='hero-header'>
	<Container>
		<article>
			<main>
				<Image
					alt={data.image.alt}
					src={`${IMG_CDN_URL}${data.image.filename}`}
					inferSize={true}
				/>
				<div>
					<h1>{data.title}</h1>
					<h2>{data.dates.birth}&ndash;{data.dates.death}</h2>
					<ReadMoreBlock>
						<div slot='summary'>
							<Fragment set:html={marked.parse(summary.trim())} />
						</div>
						<Fragment set:html={marked.parse(expandedContent.trim())} />
					</ReadMoreBlock>
				</div>
			</main>
			<footer>
				<p>🧸 Memorials may be given to <DonateLinks />.</p>
			</footer>
		</article>
	</Container>

	<script is:inline define:vars={{ fullBackground }}>
		const header = document.getElementById('hero-header');
		const img = new Image();

		// Set the source to start the download
		img.src = fullSrc;

		// When the high-res image is ready...
		img.onload = () => {
			header.classList.add('is-loaded');
		};
	</script>
</header>
