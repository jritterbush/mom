---
import PhotoThumb, { type Photo } from './PhotoThumb.astro';
import Container from './Container.astro';
import { Masonry } from 'astro-masonry';
import { IMG_CDN_URL } from '../constants/images';
import Modal from './Modal.astro';

interface Props {
	photos: Photo[];
}

const { photos } = Astro.props;
---

<style>
	ul {
		--numcolumns: 4;
		--gap: 0.25em;
		--size: calc(100vw / var(--numcolumns));
		display: grid;
		grid-template-columns: repeat(var(--numcolumns), 1fr);

		grid-template-rows: auto;
		gap: var(--gap);
		align-items: stretch;

		list-style: none;
	}

	/* Reset button styles for the thumbnails */
	.img-trigger {
		background: none;
		border: none;
		padding: var(--spacing);
		cursor: pointer;
		display: block;
		width: 100%;
	}

	.img-trigger:hover {
		outline: 1px solid black;
	}

	.full-res-image {
		display: block;
		max-width: 100%;
		max-height: 80vh;
		height: auto;
		object-fit: contain;
	}
</style>

<section>
	<Container>
		<Masonry
			breakpointCols={{
				default: 4,
				1100: 3,
				700: 2,
				500: 1,
			}}
		>
			{
				photos.map((photo) => {
					const thumbSrc = `${IMG_CDN_URL}thumbs/${photo.filename}`;
					return (
						<button
							class='img-trigger'
							data-image={photo.filename}
							aria-haspopup='dialog'
						>
							<PhotoThumb
								photo={{
									src: thumbSrc,
									...photo,
								}}
							/>
						</button>
					);
				})
			}
		</Masonry>
	</Container>
</section>

<Modal id='lightbox'>
	<img id='lightbox-img' src='' alt='' class='full-res-image' />
</Modal>

<script is:inline define:vars={{ imgCdnUrl: IMG_CDN_URL }}>
	const modal = document.getElementById('lightbox');
	const closeBtn = document.getElementById('close-lightbox');
	const lightboxImg = document.getElementById('lightbox-img');
	const imageButtons = document.querySelectorAll('.img-trigger');

	let lastFocusedElement;

	if (modal && imageButtons) {
		imageButtons.forEach((btn) => {
			btn.addEventListener('click', (event) => {
				// 1. Save reference for focus return
				lastFocusedElement = event.currentTarget;

				// 2. Get the fullsize URL
				const imageName = lastFocusedElement.dataset.image;
				const fullSizeUrl = `${imgCdnUrl}fullsize/${imageName}`;

				// 3. Update the modal image
				lightboxImg.src = fullSizeUrl;
				lightboxImg.alt =
					lastFocusedElement.querySelector('img')?.alt || 'Memorial photo';

				// 4. Show the modal
				modal.showModal();
			});
		});

		// Close logic
		closeBtn.addEventListener('click', () => modal.close());

		// A11y: Return focus when modal closes
		modal.addEventListener('close', () => {
			if (lastFocusedElement) {
				lastFocusedElement.focus();
			}
			// Clear src to stop loading/bandwidth when closed
			lightboxImg.src = '';
		});
	}
</script>
